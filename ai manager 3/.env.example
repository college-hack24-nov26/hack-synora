# ==============================================================================
# AI Personal Finance Manager - Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
PROJECT_NAME="AI Personal Finance Manager"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-min-32-chars-long"
FRONTEND_ORIGIN="http://localhost:3000"

# Data Encryption at Rest (Promise 3: Fernet 32-byte urlsafe base64 key)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="dGVzdC1lbmNyeXB0aW9uLWtleS1kZXYtMzJieXRlczE="

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=personal_finance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/personal_finance"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/personal_finance"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# JWT Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# LLM Categorization & Insights (pluggable)
LLM_PROVIDER="mock"  # mock, anthropic, gemini, openai
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL_FAST="claude-haiku-5-5"
LLM_MODEL_SMART="claude-sonnet-5-5"

# ==============================================================================
# Multi-Channel Real OTP Providers (Email & SMS)
# ==============================================================================
# Set providers to real gateways for production/testing:
#   Email: smtp | resend | sendgrid | brevo | console
#   SMS  : twilio | msg91 | console
OTP_EMAIL_PROVIDER=smtp
OTP_SMS_PROVIDER=twilio
SMS_PROVIDER=twilio

# ------------------------------------------------------------------------------
# 1. SMTP Email Configuration (e.g. Gmail App Password, Custom SMTP)
# ------------------------------------------------------------------------------
# For Gmail:
#   1. Turn on 2-Step Verification in Google Account -> Security
#   2. Create App Password at: https://myaccount.google.com/apppasswords
#   3. Use the 16-character generated password below (spaces are automatically stripped)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_USERNAME=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_USE_TLS=true
EMAIL_FROM="FinTrack AI <noreply@fintrack.ai>"
EMAIL_FROM_NAME="FinTrack AI"
EMAIL_FROM_ADDRESS="noreply@fintrack.ai"

# Third-Party Email APIs (Alternatives to SMTP)
RESEND_API_KEY=""
SENDGRID_API_KEY=""
BREVO_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Twilio SMS Configuration (Global SMS)
# ------------------------------------------------------------------------------
# For Twilio:
#   Sign up at https://www.twilio.com
#   Get Account SID, Auth Token, and Twilio phone number
#   NOTE: On Twilio Trial accounts, recipient numbers must first be verified in
#   Twilio Console -> Phone Numbers -> Manage -> Verified Caller IDs
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. MSG91 SMS Configuration (India / TRAI DLT Compliant SMS)
# ------------------------------------------------------------------------------
# For MSG91:
#   Sign up at https://msg91.com
#   Requires TRAI DLT approved template ID for Indian numbers (+91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=FINTRK
MSG91_TEMPLATE_ID=your_dlt_template_id

# Upload limits
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB

